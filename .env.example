# Public/browser variables (safe to expose in client bundles)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-public-publishable-key
# Legacy compatibility alias if your project still uses it:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only variables (never expose to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_PROJECT_ID=replace-with-project-id

# Optional browser smoke/QA settings for externally supplied staging URLs
BASE_URL=http://localhost:3000
PLAYWRIGHT_TEST_SELLER_EMAIL=replace-with-seller-email@example.com
PLAYWRIGHT_TEST_CUSTOMER_EMAIL=replace-with-customer-email@example.com
PLAYWRIGHT_TEST_ADMIN_EMAIL=replace-with-admin-email@example.com
PLAYWRIGHT_TEST_PASSWORD=replace-with-staging-password
