# Public/client configuration for browser and client-side Supabase access.
# These values are safe to expose in the browser and must be used only for anon/public access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase currently labels the browser/public key as NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# Older projects may still use NEXT_PUBLIC_SUPABASE_ANON_KEY; the app accepts either name.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-public-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key

# Server-side configuration for authenticated backend or admin operations.
# Never expose these values to browser/client code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-server-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_PROJECT_ID=replace-with-project-id

# Local development only; never commit secrets.
NEXT_PUBLIC_APP_URL=http://localhost:3000
